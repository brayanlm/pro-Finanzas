# Server
PORT=3000
NODE_ENV=development

# Database - Replace with your MongoDB Atlas connection string
# MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/finanzas?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://Finanzas:brayanlm22@clusterfinanzas.tpu9jse.mongodb.net/finanzas?retryWrites=true&w=majority

# JWT
JWT_SECRET=dev-secret-key-for-development-only-32chars-long
JWT_EXPIRES_IN=24h
JWT_ISSUER=finanzas-app
JWT_AUDIENCE=finanzas-app-users

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173

# Email (use Ethereal or similar for testing)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=test@ethereal.email
EMAIL_PASSWORD=test
EMAIL_FROM=Finanzas App <noreply@finanzas.app>

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_EXPORT_MAX=20
RATE_LIMIT_EXPORT_WINDOW_MS=3600000