# ============================================================================
# Plantilla de variables de entorno para PRUEBAS. SIN secretos reales.
# Copia a `.env.test` si lo necesitas; JAMÁS uses `.env` de producción.
# Los tests usan por defecto `mongodb-memory-server` (MongoMemoryReplSet,
# replica set efímero) y NO requieren este archivo.
# ============================================================================

NODE_ENV=test

# --- Base de datos de PRUEBAS (nunca producción / Atlas) ---------------------
# Opción A (recomendada): no definir nada -> `mongodb-memory-server` efímero.
# Opción B: instancia independiente de pruebas (localhost o cluster de test con
#   credenciales de prueba restringidas). El nombre de BD DEBE estar autorizado.
#   MONGODB_URI=mongodb://127.0.0.1:27017/finanzas_test
#   o exportar TEST_MONGODB_URI=...  (no MONGODB_URI de producción)
TEST_DB_ALLOWLIST=finanzas_test

# --- Seguridad de testing ----------------------------------------------------
# Nombres de BD de producción que deben bloquearse siempre:
PRODUCTION_DB_NAMES=finanzas,finanzas_prod,finanzas_production,production,prod

# --- JWT (valores DUMMY de test; NUNCA reutilizar los de producción) ----------
JWT_SECRET=test-secret-key-for-testing-purposes-only-32chars
JWT_EXPIRES_IN=1h
JWT_ISSUER=finanzas-app
JWT_AUDIENCE=finanzas-app-users

# --- CORS / Frontend ---------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# --- Email (dummy; no se envían correos reales en tests) ---------------------
EMAIL_HOST=smtp.test.com
EMAIL_PORT=587
EMAIL_USER=test@test.com
EMAIL_PASSWORD=test
EMAIL_FROM=Test <test@test.com>

# --- Rate limiting en test (altos en test; protección intacta en dev/prod) ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100000
RATE_LIMIT_AUTH_MAX=100000
RATE_LIMIT_EXPORT_MAX=100000
RATE_LIMIT_EXPORT_WINDOW_MS=3600000
